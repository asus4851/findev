{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "market-playground",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "backend/market-gen-ts/node_modules/vite/bin/vite.js",
        "backend/market-gen-ts",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "start",
        "--",
        "--port",
        "4200"
      ],
      "port": 4200
    }
  ]
}
